# ---------------------------------------------------------------------------
# Kinema Studio — local development environment
#
# Copy to `.env`:      cp .env.example .env
# Every value below has a working local default. You do NOT need any paid
# API key to run Kinema Studio. With no keys set, the app uses Mock adapters
# and still completes the full project -> export workflow at zero cost.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Default is a local SQLite file: zero setup, persists across restarts.
DATABASE_URL=file:./data/kinema.db
# To use PostgreSQL instead (Docker Compose profile "postgres"):
# DATABASE_URL=postgresql://kinema:kinema@localhost:5432/kinema

# --- Local storage ----------------------------------------------------------
# Media is written to this folder and persisted across restarts.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
# Optional S3/MinIO (Docker Compose profile "minio"):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Job queue --------------------------------------------------------------
# "db" = database-backed queue, no Redis required (default).
# "redis" = uses the Redis service from the Docker Compose "redis" profile.
QUEUE_DRIVER=db
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-replace-before-sharing

# --- Credential vault (AES-256-GCM envelope encryption for BYOK keys) -------
# Generate: openssl rand -base64 32
# Leave blank in development and keys are stored with a local dev key.
VAULT_MASTER_KEY=

# --- Local AI providers (no internet, no cost) ------------------------------
# Run models on your own hardware. Install one and point Kinema at it.
OLLAMA_BASE_URL=http://localhost:11434
COMFYUI_BASE_URL=http://localhost:8188
# Any other OpenAI-compatible local server (LM Studio, llama.cpp, vLLM...)
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1

# --- Cloud AI providers (all OPTIONAL) --------------------------------------
# Leave blank to use Mock/Ollama instead. Keys are encrypted at rest and are
# never written to logs. You can also add keys through the UI at
# Settings -> Providers, which is the recommended path.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=

# --- Feature flags ----------------------------------------------------------
# Keep live providers off until you have added keys and want real spending.
FEATURE_LIVE_PROVIDERS=false
FEATURE_LOCAL_WORKER=true
FEATURE_AGENT_DIRECTOR=true

# --- Render pipeline --------------------------------------------------------
# Path to an LGPL FFmpeg binary. Leave blank to auto-detect from PATH.
# Do NOT use ffmpeg-static (GPL-3.0) — see LICENSING.md.
FFMPEG_PATH=
RENDER_CONCURRENCY=2
# Chrome executable for frame capture. Blank = auto-detect.
CHROME_PATH=

# --- Development helpers ----------------------------------------------------
# Seed the database with a sample project on first run.
SEED_DEMO_DATA=true
# Where the worker writes intermediate render frames (safe to delete).
TMP_RENDER_DIR=./data/tmp