# Normalise line endings so Windows and Unix contributors do not fight over diffs.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary media: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated files: exclude from diffs and language stats.
pnpm-lock.yaml -diff
dist/** linguist-generated=true
.next/** linguist-generated=true